  {
    "comment": "Layout, as in Chorong. The resize sub-mode (r in Layout mode). Later sections win, so these arrows resize.",
    "context": "LayoutMode && resize",
    "bindings": {
      "left": [
        "chorong::ResizePane",
        {
          "direction": "left"
        }
      ],
      "shift-left": [
        "chorong::ResizePane",
        {
          "direction": "left",
          "fine": true
        }
      ],
      "right": [
        "chorong::ResizePane",
        {
          "direction": "right"
        }
      ],
      "shift-right": [
        "chorong::ResizePane",
        {
          "direction": "right",
          "fine": true
        }
      ],
      "up": [
        "chorong::ResizePane",
        {
          "direction": "up"
        }
      ],
      "shift-up": [
        "chorong::ResizePane",
        {
          "direction": "up",
          "fine": true
        }
      ],
      "down": [
        "chorong::ResizePane",
        {
          "direction": "down"
        }
      ],
      "shift-down": [
        "chorong::ResizePane",
        {
          "direction": "down",
          "fine": true
        }
      ],
      "=": "chorong::EqualizePanes",
      "enter": "chorong::ExitResizeMode",
      "escape": "chorong::ExitResizeMode"
    }
  },
  {
    "comment": "Layout, as in Chorong. Pane pickers, the Ctrl-Tab switcher and dock sizes, as in the viewer (the shell's overlay has the key context `Chorong PanePicker` / `Chorong PaneSwitcher`, so the lab repeats Ctrl-Tab there).",
    "context": "JiraDesk",
    "bindings": {
      "cmd-k /": "chorong::FocusPane",
      "cmd-k a": "chorong::BringFromTray",
      "ctrl-tab": "chorong::OpenSwitcher",
      "ctrl-shift-tab": "chorong::OpenSwitcherReverse",
      "ctrl-alt-=": "chorong::GrowDock",
      "ctrl-alt--": "chorong::ShrinkDock",
      "ctrl-alt-0": "chorong::ResetDockSize"
    }
  },
