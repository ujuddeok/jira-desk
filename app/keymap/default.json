[
  {
    "comment": "Whole app. `cmd` means Cmd on macOS and Ctrl elsewhere.",
    "context": "JiraDesk",
    "bindings": {
      "cmd-r": "jdesk::Refresh",
      "cmd-shift-r": "jdesk::FullRefresh",
      "cmd-shift-a": "jdesk::ApplyAll",
      "cmd-o": "jdesk::GoToIssue",
      "shift-/": "jdesk::ShowHelp",
      "cmd-/": "jdesk::ShowHelp",
      "cmd-q": "jdesk::Quit",
      "alt-1": "jdesk::FocusFilters",
      "alt-2": "jdesk::FocusIssues",
      "alt-3": "jdesk::FocusPreview",
      "alt-4": "jdesk::FocusNotes",
      "alt-5": "jdesk::FocusChanges",
      "alt-6": "jdesk::OpenBoard",
      "?": "jdesk::ShowHelp",
      "cmd-p": "jdesk::GoToIssue",
      "cmd-,": "jdesk::ShowSettings",
      "cmd-shift-p": "jdesk::ShowPalette"
    }
  },
  {
    "comment": "Moving in the focused pane (Vim keys and arrows).",
    "context": "JiraDesk",
    "bindings": {
      "down": "jdesk::CursorDown",
      "j": "jdesk::CursorDown",
      "up": "jdesk::CursorUp",
      "k": "jdesk::CursorUp",
      "home": "jdesk::CursorTop",
      "g g": "jdesk::CursorTop",
      "end": "jdesk::CursorBottom",
      "shift-g": "jdesk::CursorBottom",
      "pagedown": "jdesk::PageDown",
      "ctrl-d": "jdesk::PageDown",
      "pageup": "jdesk::PageUp",
      "ctrl-u": "jdesk::PageUp",
      "enter": "jdesk::Confirm",
      "space": "jdesk::Toggle"
    }
  },
  {
    "comment": "Filters: the list follows them at once. `f` starts each one.",
    "context": "JiraDesk",
    "bindings": {
      "cmd-f": "jdesk::Search",
      "/": "jdesk::Search",
      "f s": "jdesk::FilterSprint",
      "f a": "jdesk::FilterAssignee",
      "f l": "jdesk::FilterLabel",
      "f e": "jdesk::FilterEpic",
      "f t": "jdesk::FilterStatus",
      "f m": "jdesk::ToggleMine",
      "f d": "jdesk::ToggleHideDone",
      "f *": "jdesk::ToggleStarredOnly",
      "f 8": "jdesk::ToggleStarredOnly",
      "f n": "jdesk::ToggleNotedOnly",
      "f q": "jdesk::TogglePendingOnly",
      "f x": "jdesk::ClearFilters",
      "f o": "jdesk::ChooseSort",
      "f g": "jdesk::FilterTags",
      "f shift-t": "jdesk::FilterTags",
      "f v": "jdesk::ToggleReviewOnly"
    }
  },
  {
    "comment": "The current issue: each change is queued, and sent only when you apply the queue.",
    "context": "JiraDesk",
    "bindings": {
      "t": "jdesk::Transition",
      "a": "jdesk::Assign",
      "i": "jdesk::AssignToMe",
      "shift-l": "jdesk::EditLabels",
      "c": "jdesk::Comment",
      "r": "jdesk::Rename",
      "p": "jdesk::SetPoints",
      "shift-p": "jdesk::SetPriority",
      "m": "jdesk::MoveToSprint",
      "u": "jdesk::UndoChange",
      "s": "jdesk::ToggleStar",
      "n": "jdesk::EditNote",
      "o": "jdesk::OpenIssueTab",
      "shift-o": "jdesk::OpenInBrowser",
      "y": "jdesk::CopyKey",
      "shift-y": "jdesk::CopyLink",
      "shift-t": "jdesk::EditTags",
      "x": "jdesk::TogglePick",
      "shift-x": "jdesk::ClearPicks",
      "shift-f": "jdesk::FocusSeries",
      "v": "jdesk::ResolveReview"
    }
  },
  {
    "comment": "The board: columns left and right.",
    "context": "JiraDesk && board",
    "bindings": {
      "left": "jdesk::CursorLeft",
      "h": "jdesk::CursorLeft",
      "right": "jdesk::CursorRight",
      "l": "jdesk::CursorRight"
    }
  },
  {
    "comment": "The Changes pane.",
    "context": "JiraDesk && changes",
    "bindings": {
      "enter": "jdesk::ApplySelected",
      "backspace": "jdesk::DiscardChange",
      "d": "jdesk::DiscardChange",
      "r": "jdesk::RetryChange",
      "shift-r": "jdesk::ForceChange",
      "shift-c": "jdesk::ClearHistory"
    }
  },
  {
    "comment": "In a focus layout (a maximised pane or a focus series): ] and [ step pages; Tab and Shift-Tab bring the next issue from the tray into the focused spot.",
    "context": "JiraDesk && focus",
    "bindings": {
      "]": "chorong::NextFocusPage",
      "[": "chorong::PrevFocusPage",
      "tab": "chorong::NextTrayFile",
      "shift-tab": "chorong::PrevTrayFile"
    }
  },
  {
    "comment": "The Notes pane.",
    "context": "JiraDesk && notes",
    "bindings": {
      "enter": "jdesk::EditNote"
    }
  },
  {
    "comment": "The Settings pane: measure the data folder again, clear downloaded images, copy the folder's path.",
    "context": "JiraDesk && settings",
    "bindings": {
      "r": "jdesk::MeasureStorage",
      "shift-d": "jdesk::ClearImages",
      "y": "jdesk::CopyDataPath"
    }
  },
  {
    "comment": "The search bar (/ or Cmd-F): a field word (or two letters of one) then Tab or : opens a chip; Tab or Enter takes a value; Shift-Tab reopens the last chip; Esc steps back.",
    "context": "JiraSearch",
    "bindings": {
      "tab": "jdesk::SearchTab",
      "shift-tab": "jdesk::SearchReopen",
      "escape": "jdesk::InputCancel",
      "enter": "jdesk::InputConfirm",
      "cmd-enter": "jdesk::InputSubmit",
      "up": "jdesk::InputUp",
      "down": "jdesk::InputDown",
      "ctrl-p": "jdesk::InputUp",
      "ctrl-n": "jdesk::InputDown"
    }
  },
  {
    "comment": "A one-line field or a picker.",
    "context": "JiraInput",
    "bindings": {
      "escape": "jdesk::InputCancel",
      "enter": "jdesk::InputConfirm",
      "shift-enter": "jdesk::InputConfirmAlt",
      "cmd-enter": "jdesk::InputSubmit",
      "up": "jdesk::InputUp",
      "down": "jdesk::InputDown",
      "ctrl-p": "jdesk::InputUp",
      "ctrl-n": "jdesk::InputDown",
      "tab": "jdesk::InputDown",
      "shift-tab": "jdesk::InputUp"
    }
  },
  {
    "comment": "A multi-line field (comment, note). Enter starts a new line.",
    "context": "JiraText",
    "bindings": {
      "escape": "jdesk::InputCancel",
      "cmd-enter": "jdesk::InputSubmit",
      "cmd-s": "jdesk::InputSubmit"
    }
  },
  {
    "comment": "Layout, as in Chorong. Layout actions in Zed's keymap format (context, then keystroke -> action). `cmd` means Cmd on macOS and Ctrl elsewhere. Keys follow design/layout.md. MinimizePane, ReopenFocusLayout and the dock toggles have no key there, so they stay unbound (reachable from the pane menu, the status bar and the focus-history button). On integration these bindings move into app/keymap/default.json.",
    "context": "JiraDesk",
    "bindings": {
      "cmd-k m": "chorong::ToggleMaximizePane",
      "escape": "chorong::RestoreLayout"
    }
  },
  {
